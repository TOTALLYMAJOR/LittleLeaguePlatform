# Local/Docker app port
APP_PORT=8081

# Future production placeholders only. Do not put real secrets in this file.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical organization exposed by signed-out schedule and team-access routes.
# Configure this before production launch so public routes never infer a tenant.
PUBLIC_ORGANIZATION_ID=
# Family-facing service target, for example: within two business days.
PUBLIC_ACCESS_REVIEW_WINDOW=within two business days

# Feature flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_DEFAULT_PROGRAM_THEME=baseball

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://dkwghvvlbdnnwzbnscvu.supabase.co
# Must be the public anon JWT. Never put the service_role JWT in a NEXT_PUBLIC_* key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Never expose this through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dkwghvvlbdnnwzbnscvu.supabase.co:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dkwghvvlbdnnwzbnscvu.supabase.co:5432/postgres
SUPABASE_POOLER_DATABASE_URL=

# QA proof users; create/update with `npm run supabase:qa-users`.
QA_PARENT_EMAIL=
QA_PARENT_PASSWORD=
QA_COACH_EMAIL=
QA_COACH_PASSWORD=

# Maps, weather, notifications, and providers
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
TOMORROW_API_KEY=
WEATHER_PROVIDER_API_KEY=
AI_COACH_PROVIDER_ENABLED=false
AI_OPERATIONS_COPILOT_ENABLED=false
OPENAI_API_KEY=
OPENAI_AI_COACH_MODEL=gpt-5.5
OPENAI_OPERATIONS_COPILOT_MODEL=gpt-5.5
# Optional OpenAI-compatible base URL injected by Netlify AI Gateway.
OPENAI_BASE_URL=
# Canonical server-side public key used by the send adapter.
VAPID_PUBLIC_KEY=
# Optional browser mirror of the same public value. Never expose the private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=LeaguePilot
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# Pingram is the intended SMS transport. Provider presence never enables sends.
SMS_PROVIDER=pingram
PINGRAM_API_KEY=
PINGRAM_API_BASE_URL=https://api.pingram.io
PINGRAM_FROM_NUMBER=
PINGRAM_SMS_TYPE=leaguepilot_transactional_sms
PINGRAM_WEBHOOK_SECRET=
PINGRAM_CONTACT_DIGEST_SECRET=
PINGRAM_SMS_SENDER_READY=false
# Twilio remains an explicit rollback transport only when SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
PROVIDER_SENDS_ENABLED=false
PROVIDER_DELIVERY_MODE=qa
PROVIDER_PRODUCTION_APPROVED=false
PROVIDER_QA_RECIPIENT_ALLOWLIST=
# Leave unset until a reviewed scheduler/operator is authorized to run the worker.
NOTIFICATION_WORKER_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
